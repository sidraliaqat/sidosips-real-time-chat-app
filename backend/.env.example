# ============================================
# sidosips — backend environment variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file.
# ============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sidosips
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL overrides the individual DB_* values above if set
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sidosips

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
